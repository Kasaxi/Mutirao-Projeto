node_modules/
dist/
target/
src-tauri/target/
*.log
.DS_Store

# Sobra de sonda: os arquivos que a gente cria para MEDIR a CLI — hook, config
# de MCP, pid, saída de erro. São de uma sessão só e não dizem nada a quem
# clona. Três deles já entraram no repositório uma vez.
*.pid
*.err
gancho*.py
mcp[0-9]*.json
sonda*

# Segredos. A chave da API nunca entra no repositório: o adaptador a lê do
# ambiente. Um repositório privado não é cofre — quem clona, leva.
.env
.env.*
!.env.exemplo
*.pem
*.key

# Banco local de desenvolvimento. O de verdade fica em %APPDATA%.
*.db
*.db-shm
*.db-wal
